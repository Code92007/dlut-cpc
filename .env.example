BIND_ADDRESS=127.0.0.1
PORT=8021
SITE_DATA_PATH=/app/data/site.json
DATABASE_PATH=/app/runtime/dlut_cpc.sqlite3
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/app/runtime/admin_password
TRUST_PROXY_HEADERS=1

# S3-compatible private object storage for knowledge-base PDFs.
# For Cloudflare R2, endpoint is https://<account-id>.r2.cloudflarestorage.com and region is auto.
RESOURCE_S3_ENDPOINT=
RESOURCE_S3_BUCKET=
RESOURCE_S3_REGION=auto
RESOURCE_S3_ACCESS_KEY_ID=
RESOURCE_S3_SECRET_ACCESS_KEY=
RESOURCE_MAX_FILE_BYTES=52428800
# Hard application cap. Values above 9000000000 are rejected to stay below R2's 10 GB free storage tier.
RESOURCE_STORAGE_LIMIT_BYTES=9000000000
